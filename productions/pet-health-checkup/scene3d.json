{
  "meta": {
    "id": "pet-health-checkup",
    "title": "ペットの健康診断",
    "fps": 30,
    "width": 1080,
    "height": 1920
  },
  "design": {
    "format": "role-reversal",
    "title": "ペットの健康診断",
    "titleAlternatives": [
      "犬が飼い主を連れてきた",
      "診察されるのはどっち？"
    ],
    "titlePattern": "world",
    "titleOnScreen": "card",
    "titleScreenText": "ペットの\n健康診断",
    "hook": {
      "type": "in-media-res",
      "firstFrame": "動物病院。犬がリードを持ち、首輪をつけた人間が体重計に乗っている",
      "overlay": "診察されるのは人間"
    },
    "rule": "この世界では犬が飼い主で、人間がペットとして診察を受ける",
    "escalations": [
      "食事の質問に、犬が飼い主として人間の夜食について答える",
      "運動の質問に、犬が人間の散歩が週末だけだと答える",
      "体重の話になると、犬が人間の生活習慣を具体的に説明する"
    ],
    "turn": "人間が自分の話を自分に聞いてほしいと獣医に訴える",
    "payoff": "獣医の勧めで、犬が人間にリードをつけて毎日の散歩へ連れ出す",
    "button": "診察の帰り道から、人間の散歩が始まる",
    "loop": false,
    "reaction": "laugh",
    "audience": "動物病院でペットの食事や運動について相談したことがある人",
    "reality": {
      "place": "動物病院の診察室",
      "normalEvent": "獣医が飼い主にペットの食事・運動・体重について質問する",
      "onlyBreak": "犬が飼い主で、人間が犬のペットとして診察を受けている"
    },
    "payoffMechanism": "literal-callback",
    "ideation": {
      "method": "creative-thinking v3（ラジ父レンズ）。single_rule_shift / social_script_corruption / mundane_detail / literalization の4系統で16案を発散。現実の場所と出来事を固定し、ズレが一点だけの案を選定",
      "candidates": 16,
      "rejected": [
        "人間が犬を診察する普通の動物病院：逆転がなく既存の題材から先へ進まない",
        "犬が獣医になる：役割を二つ以上反転させ、最初の一画で状況が伝わらない",
        "化石や特別な首輪を身分証にする：ボケ用の小道具が主役になる",
        "犬が人間に薬を飲ませる：動物病院の診察という普通の出来事から外れてしまう",
        "犬が人間に芸をさせる：診察ではなく見世物になり、舞台の現実性が崩れる"
      ]
    }
  },
