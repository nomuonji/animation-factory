  "beats": [
    {
      "id": "title",
      "role": "title",
      "shot": "wide",
      "dur": 1.25,
      "do": [
        {
          "at": 0,
          "sfx": "title-sting"
        }
      ]
    },
    {
      "id": "question",
      "role": "hook",
      "shot": "wide",
      "pre": 0.05,
      "post": 0.1,
      "line": {
        "who": "vet",
        "text": "今日は、どちらの診察ですか？"
      }
    },
    {
      "id": "request",
      "role": "rule",
      "shot": "dog-cu",
      "pre": 0.15,
      "post": 0.2,
      "line": {
        "who": "dog",
        "text": "この子の健康診断をお願いします"
      }
    },
    {
      "id": "food",
      "role": "escalate",
      "level": 1,
      "shot": "vet-cu",
      "pre": 0.15,
      "line": {
        "who": "vet",
        "text": "最近、ごはんは食べていますか？"
      }
    },
    {
      "id": "snack",
      "role": "bridge",
      "shot": "dog-cu",
      "post": 0.15,
      "line": {
        "who": "dog",
        "text": "夜食が増えているんです"
      }
    },
    {
      "id": "me",
      "role": "bridge",
      "shot": "patient-cu",
      "post": 0.2,
      "line": {
        "who": "human",
        "text": "それ、僕の話でしょ！"
      },
      "do": [
        {
          "at": 0,
          "face": "human",
          "to": {
            "expr": "angry"
          },
          "dur": 0.25
        }
      ]
    },
    {
      "id": "exercise",
      "role": "escalate",
      "level": 2,
      "shot": "vet-cu",
      "line": {
        "who": "vet",
        "text": "運動はしていますか？"
      }
    },
    {
      "id": "weekend",
      "role": "bridge",
      "shot": "dog-cu",
      "post": 0.1,
      "line": {
        "who": "dog",
        "text": "週末にしか散歩していません"
      }
    },
    {
      "id": "objection",
      "role": "bridge",
      "shot": "patient-cu",
      "post": 0.2,
      "line": {
        "who": "human",
        "text": "週末は、歩いてます！"
      }
    },
    {
      "id": "weight",
      "role": "escalate",
      "level": 3,
      "shot": "vet-cu",
      "line": {
        "who": "vet",
        "text": "体重も、少し増えましたね"
      }
    },
    {
      "id": "sleep",
      "role": "bridge",
      "shot": "dog-cu",
      "line": {
        "who": "dog",
        "text": "帰ると、すぐ寝てしまって"
      }
    },
    {
      "id": "work",
      "role": "bridge",
      "shot": "patient-cu",
      "post": 0.1,
      "line": {
        "who": "human",
        "text": "仕事が忙しいんです！"
      }
    },
    {
      "id": "turn",
      "role": "turn",
      "shot": "over-dog",
      "post": 0.2,
      "line": {
        "who": "human",
        "text": "先生、僕の話も聞いてください！"
      }
    },
    {
      "id": "walk",
      "role": "payoff",
      "shot": "payoff",
      "post": 0.15,
      "line": {
        "who": "vet",
        "text": "では、毎日のお散歩を増やしましょう"
      },
      "do": [
        {
          "at": "line+0.1",
          "music": "cut"
        },
        {
          "at": "line+0.25",
          "move": "dog",
          "to": {
            "x": -0.58,
            "z": -0.02
          },
          "dur": 0.55,
          "ease": "inOut"
        },
        {
          "at": "line+0.25",
          "move": "human",
          "to": {
            "x": 0.05,
            "z": 1.02
          },
          "dur": 0.55,
          "ease": "inOut"
        },
        {
          "at": "line+0.3",
          "sfx": "step"
        }
      ]
    },
    {
      "id": "go",
      "role": "bridge",
      "shot": "wide",
      "post": 0.1,
      "line": {
        "who": "dog",
        "text": "はい。行こう。"
      },
      "do": [
        {
          "at": 0,
          "look": "dog",
          "to": {
            "yaw": 0.35,
            "pitch": 0.12
          },
          "dur": 0.25
        }
      ]
    },
    {
      "id": "today",
      "role": "button",
      "shot": "patient-cu",
      "post": 0.65,
      "line": {
        "who": "human",
        "text": "今から！？"
      },
      "do": [
        {
          "at": 0,
          "face": "human",
          "to": {
            "expr": "surprised"
          },
          "dur": 0.2
        }
      ]
    }
  ],
