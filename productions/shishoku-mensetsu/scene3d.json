  "beats": [
    {
      "id": "title",
      "role": "title",
      "shot": "hero",
      "dur": 1.2,
      "do": [
        {
          "at": 0,
          "sfx": "title-sting"
        }
      ]
    },
    {
      "id": "start",
      "role": "hook",
      "shot": "counter-top",
      "push": 0.05,
      "pre": 0.05,
      "line": {
        "who": "clerk",
        "text": "では、試食の面接を／始めます"
      },
      "do": [
        {
          "at": 0.05,
          "sfx": "set-down"
        }
      ]
    },
    {
      "id": "just",
      "role": "rule",
      "shot": "customer-cu",
      "post": 0.15,
      "line": {
        "who": "customer",
        "text": "……試食、／ですよね？"
      },
      "do": [
        {
          "at": 0,
          "look": "customer",
          "to": {
            "pitch": 0.3,
            "yaw": 0.2
          },
          "dur": 0.3
        },
        {
          "at": "lineEnd-0.2",
          "look": "customer",
          "to": {
            "pitch": 0.05,
            "yaw": 0
          },
          "dur": 0.3
        }
      ]
    },
    {
      "id": "q1",
      "role": "escalate",
      "level": 1,
      "shot": "clerk-cu",
      "push": 0.04,
      "line": {
        "who": "clerk",
        "text": "志望動機を、／お聞かせください"
      },
      "do": [
        {
          "at": 0,
          "pose": "clerk",
          "to": "counter",
          "dur": 0.3
        }
      ]
    },
    {
      "id": "a1",
      "role": "bridge",
      "shot": "customer-cu",
      "post": 0.15,
      "line": {
        "who": "customer",
        "text": "お腹が、空いていて……"
      },
      "do": [
        {
          "at": 0,
          "face": "customer",
          "to": "doubtful",
          "dur": 0.3
        }
      ]
    },
    {
      "id": "q2",
      "role": "escalate",
      "level": 2,
      "shot": "hero",
      "push": 0.08,
      "line": {
        "who": "clerk",
        "text": "数ある唐揚げの中から、／当店を選んだ理由は？"
      },
      "do": [
        {
          "at": 0.2,
          "pose": "clerk",
          "to": "point",
          "dur": 0.35
        },
        {
          "at": "lineEnd",
          "pose": "clerk",
          "to": "counter",
          "dur": 0.4
        }
      ]
    },
    {
      "id": "a2",
      "role": "bridge",
      "shot": "customer-cu",
      "post": 0.15,
      "line": {
        "who": "customer",
        "text": "目の前に、／あったので"
      },
      "do": [
        {
          "at": 0,
          "look": "customer",
          "to": {
            "pitch": 0.35,
            "yaw": -0.1
          },
          "dur": 0.3
        }
      ]
    },
    {
      "id": "q3",
      "role": "escalate",
      "level": 3,
      "shot": "clerk-cu",
      "push": 0.1,
      "line": {
        "who": "clerk",
        "text": "では、この唐揚げで、／あなたは何を／実現したいですか"
      },
      "do": [
        {
          "at": 0,
          "look": "clerk",
          "to": {
            "pitch": 0.08
          },
          "dur": 0.4
        }
      ]
    },
    {
      "id": "a3",
      "role": "bridge",
      "shot": "customer-cu",
      "pre": 0.3,
      "post": 0.25,
      "line": {
        "who": "customer",
        "text": "……満腹、です"
      },
      "do": [
        {
          "at": 0,
          "face": "customer",
          "to": "weary",
          "dur": 0.3
        },
        {
          "at": 0,
          "look": "customer",
          "to": {
            "pitch": 0.05,
            "yaw": 0
          },
          "dur": 0.4
        }
      ]
    },
    {
      "id": "giveup",
      "role": "turn",
      "shot": "side",
      "post": 0.2,
      "line": {
        "who": "customer",
        "text": "あの、もう／普通に買います"
      },
      "do": [
        {
          "at": 0,
          "pose": "customer",
          "to": "hand-up",
          "dur": 0.35
        },
        {
          "at": "lineEnd",
          "pose": "customer",
          "to": "idle",
          "dur": 0.4
        }
      ]
    },
    {
      "id": "final",
      "role": "payoff",
      "shot": "panel",
      "pre": 0.15,
      "post": 0.6,
      "line": {
        "who": "clerk",
        "text": "ご購入の場合は、／最終面接になります"
      },
      "do": [
        {
          "at": "line+1.0",
          "prop": "panelL",
          "to": {
            "y": 0.3
          },
          "dur": 0.35,
          "ease": "back"
        },
        {
          "at": "line+1.1",
          "prop": "panelR",
          "to": {
            "y": 0.3
          },
          "dur": 0.35,
          "ease": "back"
        },
        {
          "at": "line+1.0",
          "sfx": "payoff-hit"
        },
        {
          "at": "line+1.0",
          "music": "cut"
        },
        {
          "at": "line+1.0",
          "face": "customer",
          "to": "surprised",
          "dur": 0.2
        }
      ]
    },
    {
      "id": "probation",
      "role": "button",
      "shot": "clerk-cu",
      "pre": 0.1,
      "post": 0.4,
      "line": {
        "who": "clerk",
        "text": "なお、試用期間は／3か月です"
      },
      "do": [
        {
          "at": 0,
          "music": "resume"
        },
        {
          "at": 0.2,
          "pose": "clerk",
          "to": "give",
          "dur": 0.35
        },
        {
          "at": 0.25,
          "prop": "plate",
          "to": {
            "z": 0.22
          },
          "dur": 0.4
        }
      ]
    }
  ],
  "description": [
    "唐揚げを1個試食したいだけなのに。",
    "#ショート #コンビニ #3Dアニメ #コント #面接"
  ]
