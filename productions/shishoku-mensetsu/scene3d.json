{
  "meta": {
    "id": "shishoku-mensetsu",
    "title": "コンビニの試食に面接がある世界",
    "fps": 30,
    "width": 1080,
    "height": 1920
  },
  "design": {
    "format": "institutional-absurdity",
    "title": "コンビニの試食に面接がある世界",
    "titleAlternatives": [
      "唐揚げを試食しようとしたら面接が始まった",
      "試食の選考が厳しすぎるコンビニ"
    ],
    "titlePattern": "world",
    "titleOnScreen": "card",
    "titleScreenText": "コンビニの試食に\n面接がある世界",
    "hook": {
      "type": "anomaly-first",
      "firstFrame": "唐揚げ1皿の横に『試食 選考会場』の卓上札。柴バーガーの店員が面接官の顔で座っている",
      "overlay": "唐揚げ1個の試食です"
    },
    "rule": "試食をするには、就職面接と同じ選考を受けなければならない",
    "escalations": [
      "志望動機を聞かれる",
      "数ある唐揚げの中から当店を選んだ理由を聞かれる",
      "この唐揚げで何を実現したいか聞かれる"
    ],
    "turn": "客が『もう普通に買います』と試食を諦める",
    "payoff": "購入は最終面接。カウンターの奥から面接官がさらに2人せり上がってくる",
    "button": "『なお、試用期間は3か月です』（試食→試用）",
    "loop": false,
    "reaction": "laugh",
    "audience": "コンビニの試食や就活の面接を経験した人が、質問の既視感で止まる"
  },
  "voices": {
    "clerk": {
      "speaker": "青山龍星",
      "style": "ノーマル",
      "speed": 1.15
    },
