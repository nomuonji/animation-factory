    "comedyAudit": {
      "comicKernel": "セルフレジの『係員をお呼びします』に、ワンオペの夜勤店員が自分で駆けつけ、客の自分に丁寧に詫びる。呼ぶのも呼ばれるのも自分なので、応対するほど自分を待たせる",
      "audienceExpectation": "店員が自分の買い物をセルフレジで済ませる、ごく普通の光景。エラーが出ても店員なら自分で直せて終わる、と予測する",
      "characterIntent": "店員は夜の休憩に自分の晩ごはんを買いたい。後から来た客はタバコを買いたい。どちらも早く済ませたい",
      "pressure": "店には店員が一人しかおらず、セルフレジは客にも店員にも同じ手順を要求する。客の自分は待たされ、店員の自分は別の客に呼ばれる",
      "escalations": [
        {
          "beatId": "esc1",
          "change": "バーコードが読めない程度の呼び出しに、店員が客の自分に丁寧に詫びて直し、自分に礼を言う。呼ぶ側と呼ばれる側が同じ一人だと分かる"
        },
        {
          "beatId": "esc2",
          "change": "割引シールの確認が出て、貼ったのが自分だと店員の自分が報告する。呼び出しの理由まで自分の仕事に由来していると分かる"
        },
        {
          "beatId": "esc3",
          "change": "もう一人の客が来て、店員の自分に別の用を頼む。客の自分と店員の自分と、本物の客の三者が同時に待たされる"
        }
      ],
      "payoffCausality": "冒頭から、呼ぶのも呼ばれるのも自分であり、店員の自分は客の自分に必ず詫びる、と段ごとに示した。本物の客が現れて『いま自分が客で』という言い訳もセルフレジの呼び出しに潰され、その客が二人を別人として丁寧に扱うのは、最初に見せた型どおりの礼儀から導ける",
      "laughMoment": {
        "beatId": "payoff",
        "description": "後から来た客が、機械に呼ばれて動けない店員に『あちらのお客様、お待ちですよ』と言い、店員が誰もいない客の立ち位置に深く頭を下げて詫びる。客の自分の立ち位置には弁当だけが見える"
      },
      "independentReview": {
        "mode": "hostile-reader",
        "verdict": "pass",
        "summary": "台詞と動作だけを読み直した。一人二役の往復は画で分かるが、同じ往復だけでは単調。割引シールを貼ったのが自分という理由づけと、本物の客が来て三者が待たされる展開で段が変わる。小道具や決め台詞はなく、使うのは弁当とセルフレジだけ",
        "strongestObjection": "店員が自分の買い物でセルフレジに呼ばれる状況は、小さなドタバタを描いただけで、笑いの核が往復の繰り返しに留まるのではないか。ラストの『あちらのお客様』は台詞で説明しすぎではないか",
        "resolution": "二段目で呼び出しの理由が自分の過去の行動（シールを貼った）に由来することを示し、三段目で第三者を加えて待たせる相手を増やした。ラストの一言は、第三者の視点でだけ成立する見え方で、店員が空の立ち位置に詫びる画が主役。台詞を削っても動作で成立するようにした",
        "checks": {
          "premiseHasComicEngine": true,
          "notJustMundaneIncident": true,
          "payoffIsEarned": true,
          "characterCanonRespected": true,
          "noUnmotivatedAdditions": true,
          "notOnlyRoleReversal": true
        }
      }
    }
