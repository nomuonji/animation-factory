  "meta": {
    "id": "akabeko-shoumei",
    "title": "赤べこの証明写真",
    "fps": 30,
    "width": 1080,
    "height": 1920
  },
  "design": {
    "format": "escalation-ladder",
    "title": "赤べこの証明写真",
    "titleAlternatives": [
      "証明写真で「動かないでください」",
      "写真館に赤べこが来た"
    ],
    "titlePattern": "world",
    "titleOnScreen": "card",
    "titleScreenText": "赤べこの\n証明写真",
    "hook": {
      "type": "in-media-res",
      "firstFrame": "写真館。青い背景紙の前の丸椅子に手のひらサイズの赤べこ、手前に三脚カメラと悪魔のカメラマン",
      "overlay": "撮りまーす"
    },
    "rule": "赤べこは返事をすると首がうなずいてしまう（しゃべる＝首が揺れる）",
    "escalations": [
      "『動かないでくださいね』に『はい』と返事した瞬間、首が揺れてシャッターが切れる",
      "『すみません』と謝ると、もっと揺れる",
      "『お返事はしなくて大丈夫です』に『わかりました』で、いちばん揺れる"
    ],
    "turn": "カメラマンはあきらめず、証明写真の定番の指示『少し顎を引いてください』に切り替える",
    "payoff": "『はい』のうなずきが、ちょうど顎を引いた形になってシャッター。カメラマン『……いいですね』",
    "button": "赤べこ『ありがとうございました』（何度もうなずく＝お辞儀）",
    "loop": false,
    "reaction": "laugh",
    "audience": "証明写真や写真館で『動かないで』『顎を引いて』と言われた経験のある人が、赤べこが椅子に座っている絵で止まる",
    "reality": {
      "place": "写真館での証明写真の撮影",
      "normalEvent": "カメラマンが『動かないでくださいね』『少し顎を引いてください』と声をかけ、客が『はい』と返事する",
      "onlyBreak": "客が赤べこなので、返事をすると首がうなずいてしまう"
    },
    "payoffMechanism": "rule-was-right",
    "ideation": {
      "method": "creative-thinking（ラジ父レンズ）。single_rule_shift / premise_reinterpretation（キャラが元からそうである性質）/ literalization / institutional_absurdity / social_script_corruption の5系統で18案→現実チェック・狙いすぎチェック・既存作との重なりで落として1案",
      "candidates": 18,
      "rejected": [
        "ハロウィンの職場で『何の仮装？』→本物の悪魔：『動物に例えると→カエルです』と同じ仕組み",
        "役所で本人確認書類→悪魔がパーカーの『悪魔』の文字を見せる：ボケ用の物を見せびらかす型（化石の身分証と同じ）",
        "歯医者で『お口開けてください』→赤べこに口がない：二段目が続かず結末が唐突",
        "写真館で『口を閉じて』→悪魔のギザ歯が見えたまま：『これが普通です』という作った台詞で締めることになる",
        "会議で『異論ありませんね』→赤べこが揺れている：揺れ＝賛成が一度で分からない"
      ]
    }
  },
