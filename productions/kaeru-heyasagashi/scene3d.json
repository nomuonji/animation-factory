  "design": {
    "format": "escalation-ladder",
    "title": "カエルの部屋探し",
    "titleAlternatives": [
      "不動産屋で「日当たり良好です」",
      "カエルにおすすめの物件"
    ],
    "titlePattern": "world",
    "titleOnScreen": "card",
    "titleScreenText": "カエルの\n部屋探し",
    "hook": {
      "type": "line-first",
      "firstFrame": "不動産屋の相談カウンター。机の向こうにスーツの担当者、手前の椅子にカエル帽の客。机の上に『南向き・日当たり良好』の間取り図、奥の壁に物件チラシ",
      "overlay": "一人暮らしの部屋"
    },
    "rule": "客がカエルなので、不動産屋が長所として勧めること（日当たり・乾燥）が短所に、謝りながら伝える短所（湿気・日陰）が長所になる",
    "escalations": [
      "『南向きで日当たり良好です』に『もう少し日の当たらないところ』",
      "『風通しがよく湿気がこもりません』に『乾いちゃいますね』",
      "『一階なので梅雨は少しジメジメしますが』に身を乗り出す",
      "『裏が田んぼで、夏の夜はカエルの声が少しにぎやか』に『いいですね』"
    ],
    "turn": "担当者は勧めるのをあきらめ、『正直おすすめはしないんですが』と一番条件の悪い物件（北向きの半地下で、一日中日が入らず湿気がすごい）を出す",
    "payoff": "カエルは即決で『ここにします』",
    "button": "『内見はいつにしましょう』に『雨の日がいいです』",
    "loop": false,
    "reaction": "laugh",
    "audience": "部屋探しで『日当たり良好』『湿気が少ない』と勧められた経験のある人が、不動産屋のカウンターにカエルが座っている絵と定番の売り文句で止まる",
    "reality": {
      "place": "不動産屋の賃貸カウンターでの部屋探し",
      "normalEvent": "担当者が間取り図を出しながら『南向きで日当たり良好』『角部屋で風通しがいい』と勧め、一階の湿気や周辺環境（田んぼ・夏の虫やカエルの声）などの短所も申し訳なさそうに伝える",
      "onlyBreak": "客がカエルなので、日当たりと湿気の良し悪しが逆になる"
    },
    "payoffMechanism": "flaw-is-the-want",
    "ideation": {
      "method": "creative-thinking（ラジ父レンズ）。premise_reinterpretation（キャラが元からそうである性質）/ social_script_corruption（定番の売り文句・決まり文句）/ taste_contrast（好みが逆）/ literalization / mundane_detail の5系統で21案→現実チェック・狙いすぎチェック・既存4作（温め・動物に例えると・赤べこの証明写真・サメの歯科検診）との重なり・二段目以降が作れるかで落として1案。人の選択は入っていない（予約実行）",
      "candidates": 21,
      "rejected": [
        "健康診断で腕の短い恐竜が視力検査で目を隠せない：『届かない』の繰り返しで二段目以降の発見がなく、短い腕はベタ",
        "美容院で『サイド梳きますか』→ウーパー魔女『エラです』：訂正の一言で終わり、『これが普通です』型の作った台詞で締まる",
        "不動産屋で悪魔が暗い部屋を好む（北向き・墓地が見える）：同じ仕組みだが心霊・事故物件の方向に寄り、ボケを足していく作りになる",
        "ファミレスで赤べこに『お子様用の椅子お持ちしますか』：小ささの一発で、段が作れない",
        "自転車屋で悪魔のヘルメットが角で入らない：『入らない』の繰り返し。以前落とした『美容院で角』と同じ",
        "結婚式場の打ち合わせでカエルが『雨の日がいい』：好みが逆の同じ仕組みだが、場面の定番台詞が少なく三段目が作れない",
        "スイミングスクールで浮き輪のサメ：サメは前作。泳げないのは足した設定"
      ]
    }
  },
