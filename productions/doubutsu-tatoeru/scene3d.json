  },
  "design": {
    "format": "literalization",
    "title": "「自分を動物に例えると？」",
    "titleAlternatives": [
      "面接で動物に例えられないカエル",
      "動物に例えると、カエルです"
    ],
    "titlePattern": "world",
    "titleOnScreen": "card",
    "titleScreenText": "あなたを\n動物に例えると？",
    "hook": {
      "type": "line-first",
      "firstFrame": "会議室の面接。机の向こうに柴バーガーの面接官、手前のパイプ椅子にカエル帽の応募者",
      "overlay": "最後の質問"
    },
    "rule": "面接の定番質問『自分を動物に例えると？』を、本物の動物（カエル）が受ける",
    "escalations": [
      "『例えると』を言い直されても、例えようがない",
      "それならと、カエルとしての強みを面接どおりに答える"
    ],
    "turn": "応募者が面接官に同じ質問を聞き返す",
    "payoff": "柴の面接官は迷わず『バーガーです』",
    "button": "何事もなかったように『結果は後日ご連絡します』",
    "loop": false,
    "reaction": "laugh",
    "audience": "就活で『動物に例えると？』と聞かれた/聞かれそうな人が、質問の既視感で止まる",
    "reality": {
      "place": "会社の会議室での就職面接",
      "normalEvent": "面接官が最後に『ご自身を動物に例えると？』と聞く",
      "onlyBreak": "応募者が本物のカエルなので、例えようがない"
    },
    "payoffMechanism": "role-flip",
    "ideation": {
      "method": "creative-thinking（ラジ父レンズ）。single_rule_shift / literalization / premise_reinterpretation 等で16案→3案を本人に提示→本人が選択（他2案は『狙いすぎ』で不採用）",
      "candidates": 16
    }
  },
