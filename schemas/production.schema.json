{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animation-factory.local/schemas/production.schema.json",
  "title": "Animation Factory Production",
  "type": "object",
  "required": [
    "meta",
    "canvas",
    "environment",
    "actors",
    "events"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "duration"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "canvas": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps",
        "outputScale"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "outputScale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "environment": {
      "type": "string"
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "archetype",
          "x",
          "y"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "archetype": {
            "enum": [
              "salaryman",
              "boss",
              "robot"
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "facing": {
            "enum": [
              "left",
              "right"
            ]
          },
          "pose": {
            "enum": [
              "idle",
              "walk-a",
              "walk-b",
              "surprised",
              "dead-inside"
            ]
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "at"
        ],
        "properties": {
          "kind": {
            "enum": [
              "actor.move",
              "actor.pose",
              "dialogue.say",
              "ui.speech",
              "ui.caption",
              "ui.rpgStatus",
              "ui.essayCard",
              "camera.zoom",
              "camera.pan",
              "camera.shake",
              "effect.damage",
              "effect.exclamation",
              "effect.emote",
              "effect.particles",
              "effect.screenFlash",
              "transition.fade",
              "prop.show"
            ]
          },
          "at": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "masterVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "tts": {
          "type": "object",
          "required": [
            "provider"
          ],
          "properties": {
            "provider": {
              "enum": [
                "none",
                "espeak-ng"
              ]
            },
            "events": {
              "type": "array",
              "items": {
                "enum": [
                  "dialogue.say",
                  "ui.speech"
                ]
              },
              "uniqueItems": true
            },
            "defaultVoice": {
              "$ref": "#/$defs/ttsVoiceProfile"
            },
            "actors": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/ttsVoiceProfile"
              }
            }
          }
        },
        "bgm": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "preset"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "preset": {
                "enum": [
                  "office-night",
                  "retro-drone"
                ]
              },
              "at": {
                "type": "number",
                "minimum": 0
              },
              "duration": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "fadeIn": {
                "type": "number",
                "minimum": 0
              },
              "fadeOut": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "preset",
              "at"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "preset": {
                "enum": [
                  "heal",
                  "impact",
                  "coin",
                  "alert"
                ]
              },
              "at": {
                "type": "number",
                "minimum": 0
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ttsVoiceProfile": {
      "type": "object",
      "properties": {
        "voice": {
          "type": "string",
          "minLength": 1
        },
        "rate": {
          "type": "number",
          "minimum": 80,
          "maximum": 450
        },
        "pitch": {
          "type": "number",
          "minimum": 0,
          "maximum": 99
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    }
  }
}
