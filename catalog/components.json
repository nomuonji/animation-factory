{
  "version": 5,
  "renderer": "phaser",
  "components": [
    {
      "id": "pixel-actor",
      "kind": "actor",
      "description": "Procedural pixel actor with reusable archetypes and poses.",
      "events": {
        "actor.move": {
          "required": [
            "actor",
            "x",
            "y",
            "duration"
          ],
          "notes": "Moves linearly while automatically alternating walk-a/walk-b."
        },
        "actor.pose": {
          "required": [
            "actor",
            "pose"
          ],
          "pose": [
            "idle",
            "walk-a",
            "walk-b",
            "surprised",
            "dead-inside"
          ]
        }
      },
      "archetypes": [
        "salaryman",
        "boss",
        "robot"
      ]
    },
    {
      "id": "office-night",
      "kind": "environment",
      "description": "Pixel office environment at night.",
      "events": {}
    },
    {
      "id": "office-night-wide",
      "kind": "environment",
      "description": "Wide pixel office environment for landscape productions.",
      "events": {}
    },
    {
      "id": "dialogue-box",
      "kind": "ui",
      "description": "RPG-style fixed dialogue box.",
      "events": {
        "dialogue.say": {
          "required": [
            "actor",
            "text",
            "duration"
          ]
        }
      }
    },
    {
      "id": "speech-bubble",
      "kind": "ui",
      "description": "Actor-anchored speech bubble.",
      "events": {
        "ui.speech": {
          "required": [
            "actor",
            "text",
            "duration"
          ]
        }
      }
    },
    {
      "id": "caption",
      "kind": "ui",
      "description": "Top-of-frame caption for scene labels or punchlines.",
      "events": {
        "ui.caption": {
          "required": [
            "text",
            "duration"
          ]
        }
      }
    },
    {
      "id": "rpg-status",
      "kind": "ui",
      "description": "Compact RPG status panel with a title and text lines.",
      "events": {
        "ui.rpgStatus": {
          "required": [
            "title",
            "lines",
            "duration"
          ]
        }
      }
    },
    {
      "id": "essay-card",
      "kind": "ui",
      "description": "Large centered editorial card for long-form essays, research beats and thesis reveals.",
      "events": {
        "ui.essayCard": {
          "required": [
            "title",
            "body",
            "duration"
          ],
          "optional": [
            "kicker",
            "accent"
          ],
          "constraints": {
            "accent": "#RRGGBB"
          }
        }
      }
    },
    {
      "id": "camera-zoom",
      "kind": "camera",
      "description": "Interpolated camera zoom.",
      "events": {
        "camera.zoom": {
          "required": [
            "zoom",
            "duration"
          ],
          "constraints": {
            "zoom": "> 0"
          }
        }
      }
    },
    {
      "id": "camera-pan",
      "kind": "camera",
      "description": "Interpolates camera scroll offsets.",
      "events": {
        "camera.pan": {
          "required": [
            "x",
            "y",
            "duration"
          ]
        }
      }
    },
    {
      "id": "camera-shake",
      "kind": "camera",
      "description": "Short impact shake. Deterministic mode uses a decaying sinusoidal offset.",
      "events": {
        "camera.shake": {
          "required": [
            "duration"
          ],
          "optional": [
            "intensity"
          ]
        }
      }
    },
    {
      "id": "damage-number",
      "kind": "effect",
      "description": "Floating fading RPG damage/status text.",
      "events": {
        "effect.damage": {
          "required": [
            "actor",
            "text"
          ],
          "optional": [
            "duration"
          ]
        }
      }
    },
    {
      "id": "exclamation",
      "kind": "effect",
      "description": "Pulsing exclamation mark above an actor.",
      "events": {
        "effect.exclamation": {
          "required": [
            "actor"
          ],
          "optional": [
            "duration"
          ]
        }
      }
    },
    {
      "id": "actor-emote",
      "kind": "effect",
      "description": "Procedural pixel emote anchored to an actor.",
      "events": {
        "effect.emote": {
          "required": [
            "actor",
            "emote",
            "duration"
          ],
          "emote": [
            "sweat",
            "heart"
          ]
        }
      }
    },
    {
      "id": "pixel-particles",
      "kind": "effect",
      "description": "Deterministic radial pixel particles.",
      "events": {
        "effect.particles": {
          "required": [
            "actor",
            "particle",
            "duration"
          ],
          "particle": [
            "spark",
            "coin",
            "dust"
          ]
        }
      }
    },
    {
      "id": "screen-flash",
      "kind": "effect",
      "description": "Full-screen impact flash.",
      "events": {
        "effect.screenFlash": {
          "required": [
            "duration"
          ],
          "optional": [
            "color",
            "strength"
          ],
          "constraints": {
            "color": "#RRGGBB",
            "strength": "0..1"
          }
        }
      }
    },
    {
      "id": "fade-transition",
      "kind": "transition",
      "description": "Persistent fade-out or fade-in overlay.",
      "events": {
        "transition.fade": {
          "required": [
            "mode",
            "duration"
          ],
          "optional": [
            "color"
          ],
          "mode": [
            "in",
            "out"
          ]
        }
      }
    },
    {
      "id": "procedural-props",
      "kind": "prop",
      "description": "Temporary procedural pixel props.",
      "events": {
        "prop.show": {
          "required": [
            "prop",
            "x",
            "y",
            "duration"
          ],
          "optional": [
            "scale"
          ],
          "prop": [
            "coffee",
            "briefcase",
            "coin"
          ]
        }
      }
    }
  ],
  "three": {
    "doc": "docs/three-shorts.md",
    "runtime": "src/three",
    "production": "productions/<id>/scene3d.json",
    "sets": {
      "convenience-store": {
        "cameras": [
          "hero",
          "wide",
          "side",
          "clerk-cu",
          "customer-cu",
          "counter-top",
          "over-clerk"
        ],
        "surfaces": {
          "counter": 0.96,
          "backCounter": 0.9
        }
      },
      "interview-room": {
        "cameras": [
          "wide",
          "side",
          "interviewer-cu",
          "candidate-cu",
          "over-interviewer",
          "over-candidate"
        ],
        "surfaces": {
          "desk": 0.72,
          "floor": 0
        },
        "notes": "会社の会議室での面接。面接官の机（前板で脚が隠れる）z≈-0.4、応募者の椅子は prop（kaykit chair_A, scale 0.8, z≈1.05）。actor.seated=true で座らせる"
      },
      "photo-studio": {
        "cameras": [
          "wide",
          "side",
          "sitter-cu",
          "photographer-cu",
          "over-photographer"
        ],
        "surfaces": {
          "floor": 0
        },
        "notes": "写真館（証明写真・ポートレート）。奥 z≈-1.75 に背景紙（params.backdrop で色）、被写体の椅子は prop（kaykit chair_stool, 高さ0.5）を z≈-0.6 に、撮影者側 z>0.6。三脚カメラ（photo-camera）とストロボ（strobe, param flash）は prop"
      },
      "dental-clinic": {
        "cameras": [
          "wide",
          "side",
          "patient-cu",
          "dentist-cu",
          "over-dentist"
        ],
        "surfaces": {
          "floor": 0,
          "seat": 0.52,
          "tray": 1.1
        },
        "notes": "歯科医院の診療台（定期検診・治療）。患者は原点の診療台に +Z 向き、背もたれは params.recline（既定0.62rad）で -Z 側へ倒れる。VRM 患者は seated:true と root.rx=-recline で寝かせる（LilShark height1.2 なら root {y:0.2,z:0.05}）。歯科医は患者の右（x≈-0.5, z≈-0.3, ry=π/2）、うがいの鉢・コップ・器具トレーは患者の左、無影灯は顔の上（params.lampOff で消灯）"
      },
      "real-estate-office": {
        "cameras": [
          "wide",
          "agent-cu",
          "customer-cu",
          "over-customer",
          "over-agent",
          "desk-top"
        ],
        "surfaces": {
          "desk": 0.72,
          "floor": 0,
          "seat": 0.48
        },
        "notes": "不動産屋の賃貸カウンター（部屋探し・物件紹介）。相談机 z≈-0.35（天板0.72、中央の目隠し板、両側に低い仕切り）。担当者は机の奥 z≈-0.85 で +Z 向き（手続き型人物は seated:true＋root.y≈-0.32）、客は手前の椅子 z≈0.25 で -Z 向き（椅子は prop）。奥の壁に物件チラシのコルクボードと「おすすめ物件」（params.header, params.accent）、右に物件チラシを貼った窓、左にパンフ棚。机の間取り図は floor-plan prop"
      }
    },
    "props": {
      "onigiri": [
        "label",
        "size"
      ],
      "paper-stack": [
        "height",
        "title",
        "clauses"
      ],
      "document": [
        "title",
        "clauses",
        "signature",
        "noFill",
        "footer",
        "param:sig",
        "param:stamp"
      ],
      "binder": [
        "w",
        "d",
        "height",
        "color",
        "title",
        "label",
        "volume"
      ],
      "pen": [
        "color"
      ],
      "hanko": [],
      "box": [
        "size",
        "color"
      ],
      "gltf": [
        "src (assets/3d/...)",
        "scale"
      ],
      "photo-camera": [
        "height",
        "tilt"
      ],
      "strobe": [
        "height",
        "size",
        "tilt",
        "power",
        "param:flash"
      ],
      "floor-plan": [
        "layout",
        "rent",
        "room",
        "tags[]",
        "seed",
        "accent",
        "tagColor",
        "w",
        "d"
      ]
    },
    "character": {
      "style": [
        "skin",
        "hair",
        "hairStyle(side-part|ponytail|short|bald)",
        "top",
        "vest",
        "vestTrim",
        "bottom",
        "shoes",
        "glasses",
        "nameTag",
        "hood",
        "height",
        "horns",
        "ears(round|pointed)",
        "print",
        "printColor",
        "teeth",
        "cheeks",
        "hairStyle:spiky",
        "eyeStyle(dot|big)",
        "iris",
        "boldBrows",
        "eyeShadow",
        "mask"
      ],
      "poses": [
        "idle",
        "counter",
        "hold-doc",
        "lift-doc",
        "point",
        "stamp-up",
        "stamp-down",
        "give",
        "sign",
        "hand-up",
        "bow",
        "hold-up"
      ],
      "expressions": [
        "neutral",
        "blank",
        "polite",
        "surprised",
        "doubtful",
        "weary",
        "grin",
        "smug"
      ],
      "vrm": "actors.<id>.vrm = assets/3d/avatars/*.vrm, height"
    },
    "actions": [
      "pose",
      "move",
      "look",
      "face",
      "prop",
      "show",
      "hide",
      "param",
      "wiggle",
      "sfx",
      "shot",
      "music"
    ],
    "sfx": "catalog/sfx3d.json",
    "design": {
      "doc": "docs/short-drama-design.md",
      "formats": "catalog/skit-formats.json",
      "template": "templates/skit3d.json",
      "lint": "tools/three/design-lint.mjs"
    },
    "assets": "catalog/assets3d.json",
    "figures": {
      "akabeko": "actors.<id>.figure = \"akabeko\" (+ height, figureParams.body/pattern); head nods per mora instead of a mouth",
      "chibi": "actors.<id>.figure = \"chibi\" + style {skin,hair,top,bottom,shoes,horns,ears,tail,print,printColor,cheeks,hood,fang}; cute ~2.2-head build, same poses/face/lip movement"
    },
    "cast": "catalog/cast3d.json — actors.<id>.cast = akuma | akabeko (channel main characters)"
  }
}
