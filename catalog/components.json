{
  "version": 5,
  "renderer": "phaser",
  "components": [
    {
      "id": "pixel-actor",
      "kind": "actor",
      "description": "Procedural pixel actor with reusable archetypes and poses.",
      "events": {
        "actor.move": {
          "required": [
            "actor",
            "x",
            "y",
            "duration"
          ],
          "notes": "Moves linearly while automatically alternating walk-a/walk-b."
        },
        "actor.pose": {
          "required": [
            "actor",
            "pose"
          ],
          "pose": [
            "idle",
            "walk-a",
            "walk-b",
            "surprised",
            "dead-inside"
          ]
        }
      },
      "archetypes": [
        "salaryman",
        "boss",
        "robot"
      ]
    },
    {
      "id": "office-night",
      "kind": "environment",
      "description": "Pixel office environment at night.",
      "events": {}
    },
    {
      "id": "office-night-wide",
      "kind": "environment",
      "description": "Wide pixel office environment for landscape productions.",
      "events": {}
    },
    {
      "id": "dialogue-box",
      "kind": "ui",
      "description": "RPG-style fixed dialogue box.",
      "events": {
        "dialogue.say": {
          "required": [
            "actor",
            "text",
            "duration"
          ]
        }
      }
    },
    {
      "id": "speech-bubble",
      "kind": "ui",
      "description": "Actor-anchored speech bubble.",
      "events": {
        "ui.speech": {
          "required": [
            "actor",
            "text",
            "duration"
          ]
        }
      }
    },
    {
      "id": "caption",
      "kind": "ui",
      "description": "Top-of-frame caption for scene labels or punchlines.",
      "events": {
        "ui.caption": {
          "required": [
            "text",
            "duration"
          ]
        }
      }
    },
    {
      "id": "rpg-status",
      "kind": "ui",
      "description": "Compact RPG status panel with a title and text lines.",
      "events": {
        "ui.rpgStatus": {
          "required": [
            "title",
            "lines",
            "duration"
          ]
        }
      }
    },
    {
      "id": "essay-card",
      "kind": "ui",
      "description": "Large centered editorial card for long-form essays, research beats and thesis reveals.",
      "events": {
        "ui.essayCard": {
          "required": [
            "title",
            "body",
            "duration"
          ],
          "optional": [
            "kicker",
            "accent"
          ],
          "constraints": {
            "accent": "#RRGGBB"
          }
        }
      }
    },
    {
      "id": "camera-zoom",
      "kind": "camera",
      "description": "Interpolated camera zoom.",
      "events": {
        "camera.zoom": {
          "required": [
            "zoom",
            "duration"
          ],
          "constraints": {
            "zoom": "> 0"
          }
        }
      }
    },
    {
      "id": "camera-pan",
      "kind": "camera",
      "description": "Interpolates camera scroll offsets.",
      "events": {
        "camera.pan": {
          "required": [
            "x",
            "y",
            "duration"
          ]
        }
      }
    },
    {
      "id": "camera-shake",
      "kind": "camera",
      "description": "Short impact shake. Deterministic mode uses a decaying sinusoidal offset.",
      "events": {
        "camera.shake": {
          "required": [
            "duration"
          ],
          "optional": [
            "intensity"
          ]
        }
      }
    },
    {
      "id": "damage-number",
      "kind": "effect",
      "description": "Floating fading RPG damage/status text.",
      "events": {
        "effect.damage": {
          "required": [
            "actor",
            "text"
          ],
          "optional": [
            "duration"
          ]
        }
      }
    },
    {
      "id": "exclamation",
      "kind": "effect",
      "description": "Pulsing exclamation mark above an actor.",
      "events": {
        "effect.exclamation": {
          "required": [
            "actor"
          ],
          "optional": [
            "duration"
          ]
        }
      }
    },
    {
      "id": "actor-emote",
      "kind": "effect",
      "description": "Procedural pixel emote anchored to an actor.",
      "events": {
        "effect.emote": {
          "required": [
            "actor",
            "emote",
            "duration"
          ],
          "emote": [
            "sweat",
            "heart"
          ]
        }
      }
    },
    {
      "id": "pixel-particles",
      "kind": "effect",
      "description": "Deterministic radial pixel particles.",
      "events": {
        "effect.particles": {
          "required": [
            "actor",
            "particle",
            "duration"
          ],
          "particle": [
            "spark",
            "coin",
            "dust"
          ]
        }
      }
    },
    {
      "id": "screen-flash",
      "kind": "effect",
      "description": "Full-screen impact flash.",
      "events": {
        "effect.screenFlash": {
          "required": [
            "duration"
          ],
          "optional": [
            "color",
            "strength"
          ],
          "constraints": {
            "color": "#RRGGBB",
            "strength": "0..1"
          }
        }
      }
    },
    {
      "id": "fade-transition",
      "kind": "transition",
      "description": "Persistent fade-out or fade-in overlay.",
      "events": {
        "transition.fade": {
          "required": [
            "mode",
            "duration"
          ],
          "optional": [
            "color"
          ],
          "mode": [
            "in",
            "out"
          ]
        }
      }
    },
    {
      "id": "procedural-props",
      "kind": "prop",
      "description": "Temporary procedural pixel props.",
      "events": {
        "prop.show": {
          "required": [
            "prop",
            "x",
            "y",
            "duration"
          ],
          "optional": [
            "scale"
          ],
          "prop": [
            "coffee",
            "briefcase",
            "coin"
          ]
        }
      }
    }
  ]
}
