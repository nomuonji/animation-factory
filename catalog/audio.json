{
  "version": 4,
  "sampleRate": 48000,
  "tts": {
    "providers": [
      "none",
      "espeak-ng",
      "piper-plus",
      "voicevox",
      "voicevox-nemo"
    ],
    "eventKinds": [
      "dialogue.say",
      "ui.speech"
    ],
    "defaultVoice": {
      "voice": "tsukuyomi",
      "rate": 175,
      "pitch": 50,
      "volume": 1
    },
    "notes": "voicevox-nemo is the free default for this YouTube series; it uses the official local Nemo engine and stores the required VOICEVOX Nemo credit in meta.credits. voicevox remains available for character libraries. Paid cloud TTS is not part of the default pipeline."
  },
  "bgmPresets": {
    "office-night": "Low synthetic office-night drone with subtle pink-noise room tone.",
    "retro-drone": "Minimal low retro synth drone."
  },
  "sfxPresets": {
    "heal": "Ascending two-tone recovery cue.",
    "impact": "Short filtered noise hit.",
    "coin": "Two-tone coin pickup cue.",
    "alert": "Two-step warning beep."
  },
  "soundBank": {
    "storage": "repository-local, pre-downloaded CC0 packs",
    "indexTool": "node tools/sound-bank.mjs",
    "roles": [
      "hook_hit",
      "impact",
      "thud",
      "pop",
      "click",
      "transition",
      "reveal",
      "fail",
      "suspense"
    ],
    "sourcePackIds": [
      "interface-sounds",
      "impact-sounds",
      "music-jingles"
    ],
    "youtubeShortsMusicPolicy": "YouTube Shorts licensed/trending songs are platform-scoped and NOT downloaded/reused by automated uploads; use cleared files only",
    "selection": "deterministic role + production + cue id",
    "introSound": "hook_hit",
    "recommendedMix": {
      "ttsFirst": true,
      "bgmLevel": 0.1,
      "sfxLevel": 0.35
    }
  },
  "musicAssetIds": [
    "safe-space-loop",
    "flowerbed-fields",
    "battle-music-loop"
  ]
}
